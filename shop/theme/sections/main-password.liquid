{%- comment -%}
  Password gate — "private viewing hour at a small museum."
  Preserves all Dawn form mechanics (storefront_password form helper).
  Replaces the default email-signup-banner approach.
{%- endcomment -%}

<div class="pw-gate">
  <div class="pw-gate__inner">

    {%- comment -%} Chapter ornament {%- endcomment -%}

    {%- comment -%} Wordmark {%- endcomment -%}
    <p class="pw-gate__wordmark" aria-label="{{ shop.name }}">hearts in jars</p>

    <p class="pw-gate__tagline">A small print studio. Open by appointment.</p>

    {%- comment -%} Diamond rule divider {%- endcomment -%}

    {%- comment -%}
      Framed password form.
      Dawn's password-modal.js expects a <password-modal> wrapping <details>
      but on the password template the form can also live inline.
      We render it inline here for clarity and brand immersion.
    {%- endcomment -%}
    <div class="pw-gate__form-frame">
      {%- comment -%} Corner ornaments {%- endcomment -%}

      {%- form 'storefront_password', class: 'pw-gate__form' -%}
        {%- if form.errors -%}
          <div class="pw-gate__form-error" role="alert">
            <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
            {{ 'general.password_page.login_form_error' | t }}
          </div>
        {%- endif -%}

        <label class="pw-gate__label font-smcp" for="PwGatePassword">
          Enter Password
        </label>

        <div class="pw-gate__field{% if form.errors %} pw-gate__field--error{% endif %}">
          <input
            type="password"
            name="password"
            id="PwGatePassword"
            class="pw-gate__input"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PwGatePasswordError"
            {%- endif -%}
          >
        </div>

        <button type="submit" name="commit" class="pw-gate__submit font-smcp">
          Enter
        </button>
      {%- endform -%}

      <p class="pw-gate__hint">Most orders ship in 7&ndash;14 days.</p>
    </div>

    {%- comment -%} Subtle Shopify attribution (required) {%- endcomment -%}
    {%- capture shopify_link -%}
      <a class="pw-gate__shopify-link" href="//www.shopify.com" rel="nofollow" target="_blank" aria-describedby="a11y-new-window-message" aria-label="Shopify">
        {{- 'icon-shopify.svg' | inline_asset_content -}}
      </a>
    {%- endcapture -%}
    <small class="pw-gate__powered">
      {{- 'general.password_page.powered_by_shopify_html' | t: shopify: shopify_link -}}
    </small>

  </div>
</div>

<ul hidden>
  <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
</ul>

<style>
  /* -----------------------------------------------------------
     Password gate — private-viewing-hour aesthetic
     ----------------------------------------------------------- */

  /* Suppress the default Dawn password header/footer on this template
     so only our gate is visible. We keep their Liquid for JS hooks. */
  .password-header,
  .password__footer {
    display: none !important;
  }

  /* Override body to ensure full-height centering */
  body.password {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-canvas);
  }

  .password-main {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    width: 100%;
    padding: var(--space-12) var(--space-6);
  }

  /* Gate container */
  .pw-gate {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .pw-gate__inner {
    max-width: 480px;
    width: 100%;
    text-align: center;
    animation: pw-gate-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Chapter ornament */
  .pw-gate__chapter {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-6);
    color: var(--color-accent-gold);
  }

  .pw-gate__chapter svg {
    width: 120px;
    height: 16px;
  }

  /* Wordmark — Cormorant Garamond 600, gold */
  .pw-gate__wordmark {
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: clamp(3.2rem, 5vw, 4rem);
    letter-spacing: 0.06em;
    line-height: 1.1;
    color: var(--color-accent-gold);
    margin: 0 0 var(--space-3) 0;
  }

  /* Tagline — EB Garamond italic, muted */
  .pw-gate__tagline {
    font-family: var(--font-body-family);
    font-style: italic;
    font-size: 1.8rem;
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-6) 0;
    line-height: 1.5;
  }

  /* Rule divider */
  .pw-gate__rule {
    display: flex;
    justify-content: center;
    margin: 0 auto var(--space-8);
    color: var(--color-border-muted);
    max-width: 240px;
  }

  .pw-gate__rule svg {
    width: 100%;
    height: auto;
  }

  /* Framed form panel */
  .pw-gate__form-frame {
    position: relative;
    background-color: var(--color-bg-inset);
    border: 1px solid var(--color-border-frame);
    padding: var(--space-8) var(--space-8) var(--space-6);
    margin-bottom: var(--space-8);
  }

  /* Corner ornaments on the form frame */
  .pw-gate__corner {
    position: absolute;
    display: flex;
    width: 28px;
    height: 28px;
    color: var(--color-border-frame);
  }

  .pw-gate__corner svg {
    width: 28px;
    height: 28px;
  }

  .pw-gate__corner--tl { top: -1px; left: -1px; }
  .pw-gate__corner--tr { top: -1px; right: -1px; transform: scaleX(-1); }
  .pw-gate__corner--bl { bottom: -1px; left: -1px; transform: scaleY(-1); }
  .pw-gate__corner--br { bottom: -1px; right: -1px; transform: scale(-1, -1); }

  /* Error message */
  .pw-gate__form-error {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    color: var(--color-error-text);
    background-color: rgba(140, 58, 53, 0.15);
    border: 1px solid var(--color-error);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
    text-align: left;
  }

  /* Label — Cormorant SC small-caps, gold */
  .pw-gate__label {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    color: var(--color-accent-gold);
    margin-bottom: var(--space-3);
    text-align: left;
  }

  /* Input field */
  .pw-gate__field {
    margin-bottom: var(--space-5);
  }

  .pw-gate__input {
    display: block;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-canvas);
    border: 1px solid var(--color-border-frame);
    color: var(--color-fg-body);
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.5;
    box-sizing: border-box;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .pw-gate__input::placeholder {
    color: var(--color-fg-faint);
    font-style: italic;
  }

  .pw-gate__input:focus,
  .pw-gate__input:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 3px;
    border-color: var(--color-accent-gold);
  }

  .pw-gate__field--error .pw-gate__input {
    border-color: var(--color-error);
  }

  /* Submit button — filled gold, small-caps */
  .pw-gate__submit {
    display: block;
    width: 100%;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-accent-gold);
    color: var(--color-bg-canvas);
    border: 1px solid var(--color-accent-gold);
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .pw-gate__submit:hover,
  .pw-gate__submit:focus-visible {
    background-color: transparent;
    color: var(--color-accent-gold);
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 3px;
  }

  /* Hint below submit */
  .pw-gate__hint {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    color: var(--color-fg-faint);
    margin: var(--space-5) 0 0 0;
    line-height: 1.5;
  }

  /* Powered-by attribution */
  .pw-gate__powered {
    display: block;
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    color: var(--color-fg-faint);
    line-height: 1.5;
  }

  .pw-gate__shopify-link svg {
    display: inline-block;
    vertical-align: middle;
    width: 50px;
    height: auto;
    fill: var(--color-fg-faint);
    opacity: 0.6;
  }

  /* Entrance animation */
  @keyframes pw-gate-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile */
  @media screen and (max-width: 639px) {
    .pw-gate__form-frame {
      padding: var(--space-6) var(--space-5) var(--space-5);
    }

    .pw-gate__wordmark {
      font-size: 3.2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Password gate",
  "tag": "section",
  "class": "section"
}
{% endschema %}
