{%- comment -%}
  About teaser
  Brand-tailored homepage about block per plan §1.4 / §2.6.
  Chapter ornament + small heading + EB Garamond body, with an
  optional italic "read more" link to /pages/about.
{%- endcomment -%}

<div
  class="about-teaser color-{{ section.settings.color_scheme }} isolate"
  data-section-id="{{ section.id }}"
>
  <div class="about-teaser__inner">
    <span class="about-teaser__ornament" aria-hidden="true">
      {{ 'ornament-chapter.svg' | inline_asset_content }}
    </span>

    {%- if section.settings.heading != blank -%}
      <h2 class="about-teaser__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="about-teaser__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <p class="about-teaser__link-wrap">
        <a class="about-teaser__link" href="{{ section.settings.link_url }}">
          {{ section.settings.link_label | escape }}
        </a>
      </p>
    {%- endif -%}
  </div>
</div>

<style>
  .about-teaser {
    width: 100%;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    background-color: transparent;
  }

  /* Scheme-2 raised-surface treatment — subtle inset so the section
     reads as a panel against the canvas without breaking continuity. */
  .about-teaser.color-scheme-2 {
    background-color: var(--color-bg-raised, transparent);
  }

  .about-teaser__inner {
    max-width: 64rem;
    margin: 0 auto;
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
  }

  .about-teaser__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 16px;
    color: var(--color-accent-gold);
    line-height: 0;
  }

  .about-teaser__ornament svg {
    width: 120px;
    height: 16px;
    display: block;
  }

  .about-teaser__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 600;
    font-size: 3rem;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--color-fg-body);
  }

  .about-teaser__body {
    max-width: 56rem;
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  .about-teaser__body p {
    margin: 0 0 var(--space-3);
  }

  .about-teaser__body p:last-child {
    margin-bottom: 0;
  }

  .about-teaser__link-wrap {
    margin: 0;
  }

  .about-teaser__link {
    font-family: var(--font-body-family);
    font-style: italic;
    font-size: 1.8rem;
    color: var(--color-fg-faint, var(--color-fg-muted));
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-gold);
    padding-bottom: 2px;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .about-teaser__link:hover,
  .about-teaser__link:focus-visible {
    color: var(--color-accent-gold);
    border-color: var(--color-fg-body);
  }

  .about-teaser__link:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 3px;
  }
</style>

{% schema %}
{
  "name": "About teaser",
  "tag": "section",
  "class": "section section-about-teaser",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The studio"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Behind every order is one person at a small 3D printer. We work from a curated catalog of designs — some original, some licensed from independent creators — and from your own files when you bring them. Lead times vary; the work is slow because the work is by hand.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read more about the studio"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "About teaser",
      "settings": {
        "color_scheme": "scheme-2"
      }
    }
  ]
}
{% endschema %}
