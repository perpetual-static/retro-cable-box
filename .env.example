# Copy to `.env` to override local defaults.
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=box
# TEMPORAL_TASK_QUEUE=box
# MCP_PORT=8750
# API_PORT=8760
# MEDIA_ROOT=/abs/path/media  # local files (default: <repo>/media) the `local` source kind may point at
# SEED_LINEUP=lineups/starter.json
# MCP_TOKEN=                  # when set, /mcp requires "Authorization: Bearer <token>"
